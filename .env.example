# Optional. A public HTTPS endpoint that answers the assistant request with
# { "text": "..." }. Absent means the assistant uses its local fallback.
# See docs/ASSISTANT_REMOTE_PROVIDER.md.
NUXT_PUBLIC_ASSISTANT_ENDPOINT_URL=

# Written by `pnpm exec better-convex-nuxt-convex configure`.
# The Convex deployment URL is public by design — it is the address the client
# talks to, not a credential. No Convex key, admin token or model key may ever
# appear in this file's real counterpart on a device: RNF-006 keeps every
# secret server-side, and this APK is a static bundle that cannot hide one.
NUXT_PUBLIC_CONVEX_URL=
